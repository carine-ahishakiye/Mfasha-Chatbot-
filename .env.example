# Copy to .env and edit. Every value has a safe default.
DATABASE_URL=sqlite:///./mfasha.db
MFASHA_RETRIEVER=hybrid            # bm25 | tfidf | hybrid | embedding
MFASHA_ENABLE_STT=false            # true needs requirements-ml.txt and ~4 GB of RAM
MFASHA_ENABLE_TTS=false
MFASHA_API_KEY=change-me           # protects /api/officer/* and /api/admin/*
MFASHA_SERVE_UNREVIEWED=false      # keep false in the pilot: only officer-reviewed answers are shown
MFASHA_KNOWLEDGE_PATH=data/sample/passages.jsonl
MFASHA_REVIEWED_PATH=data/sample/officer_reviewed_passages.csv
